# std.process — running other programs.
# This file is built into the compiler and is merged into your program when you write `import std.process`.

struct Output:
    code: Int
    out: Str
    err: Str

    fn ok(self) -> Bool:
        return self.code == 0

# Runs one shell command line. Pipes work too, as in `run("ls -l | wc -l")`.
# When putting user-supplied text into a command, use run_args instead (no shell gets involved).
fn run(command: Str) -> Output:
    let code = __run(command, [], true)
    return Output(code: code, out: __run_out(), err: __run_err())

# Runs a program with its name and arguments passed separately. Does not go through the shell.
fn run_args(program: Str, arguments: [Str]) -> Output:
    let code = __run(program, arguments, false)
    return Output(code: code, out: __run_out(), err: __run_err())
