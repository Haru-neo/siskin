# std.net: checks HTTP and TCP on this machine (python3 tests/net/net_srv.py 18431 must be running)
import std.net

fn show(r: Response):
    print(f"{r.status} {r.ok()} [{r.body}]\n")

fn attempt(r: !Response):
    let v = r catch e:
        print("error: " + e + "\n")
        return
    show(v)

fn main():
    let base = "http://127.0.0.1:18431"
    let a = http_get(base + "/hello?q=" + url_encode("김 밥&")) catch e:
        print("failed: " + e + "\n")
        return
    show(a)
    print((a.header("Content-Type") else "?") + " / " + (a.headers["x-test"] else "?") + "\n")
    attempt(http_get(base + "/chunk"))
    attempt(http_get(base + "/go"))
    attempt(http_get(base + "/rel/a"))
    attempt(http_get(base + "/nope"))
    attempt(http_post(base + "/echo", "{\"a\": 1}"))
    attempt(http_post(base + "/echo", "just text"))
    attempt(http_post(base + "/see", "x"))
    attempt(http_request("GET", base + "/ua", {"User-Agent": "myapp/1", "X-Key": "k1"}, ""))
    let bad = [base + "/loop", "ftp://x", "http://127.0.0.1:1/", "http://없는호스트.invalid/"]
    for u in bad:
        let r = http_get(u) catch e:
            print("error: " + e + "\n")
            continue
        show(r)

    # TCP: both server and client in one program
    let srv = listen_on("127.0.0.1", 0) catch e:
        print(e + "\n")
        return
    let port = srv.port()
    print(f"{port > 0}\n")
    let c = connect("127.0.0.1", port) catch e:
        print(e + "\n")
        return
    c.send("hello server\nsecond line\n") catch e:
        print(e + "\n")
    let s = srv.accept() catch e:
        print(e + "\n")
        return
    let l1 = s.recv_line() catch e:
        "?"
    let l2 = s.recv_line() catch e:
        "?"
    print("server got: " + l1 + "server got: " + l2)
    print(f"{s.peer().starts_with('127.0.0.1:')}\n")
    s.send("nice to meet you") catch e:
        print(e + "\n")
    s.close()
    let got = c.recv() catch e:
        "?"
    let end = c.recv() catch e:
        "?"
    print(f"client got: {got} / end: [{end}]\n")
    c.close()
    let again = c.recv() catch e:
        "error: " + e
    print(again + "\n")
    let taken = listen_on("127.0.0.1", port) catch e:
        Server(id: -1)
    print(f"{taken.id >= 0}\n")
    srv.close()
    let refused = connect("127.0.0.1", port) catch e:
        print("error: " + e.replace(str(port), "PORT") + "\n")
        return
