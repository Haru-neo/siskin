# https server: opens a secure port with a test certificate and makes https requests to it from the same program.
# tests/tools.sh creates the certificate (cert.pem, key.pem). SSL_CERT_FILE=cert.pem makes it trusted.
import std.net

fn serve(server: Server, count: Int) -> Int:
    var served = 0
    while served < count:
        let req = server.next_request() catch e:
            print("server error: " + e + "\n")
            return served
        if req.path == "/hello":
            let name = req.query["name"] else "guest"
            req.respond(200, f"Hello, {name}") catch e:
                print(e + "\n")
        elif req.method == "POST":
            req.respond(201, "{\"got\": " + f"{req.body.len()}" + "}") catch e:
                print(e + "\n")
        else:
            req.respond(404, "<h1>not found</h1>") catch e:
                print(e + "\n")
        served += 1
    return served

fn main():
    let server = listen_tls_on("127.0.0.1", 0, "cert.pem", "key.pem") catch e:
        print("cannot listen: " + e + "\n")
        return
    let port = server.port()
    let job = spawn serve(server, 3)
    let base = f"https://localhost:{port}"
    let a = http_get(base + "/hello?name=%EA%B9%80+%EB%B0%A5") catch e:
        print("failed: " + e + "\n")
        return
    print(f"{a.status} {a.header("content-type") else "?"} {a.body}\n")
    let b = http_post(base + "/data", "[1, 2, 3]") catch e:
        print("failed: " + e + "\n")
        return
    print(f"{b.status} {b.body}\n")
    let c = http_get(base + "/nope") catch e:
        print("failed: " + e + "\n")
        return
    print(f"{c.status} {c.body}\n")
    print(f"requests handled: {job.wait()}\n")
    server.close()
