# std.net — internet connections (HTTP requests, TCP connections, servers).
# This file is built into the compiler and is merged into your program when you write `import std.net`.
# Networking has to talk to the operating system directly, so when this module is used `siskin run`
# also quietly compiles natively and runs the result (the same as when using a C library).

# ---- HTTP ----

struct Response:
    status: Int
    headers: {Str: Str}
    body: Str

    # Success means 200-299.
    fn ok(self) -> Bool:
        return self.status >= 200 and self.status < 300

    # Header names are case-insensitive. none if missing.
    fn header(self, name: Str) -> ?Str:
        return self.headers[name.lower()]

fn __response(status: Int) -> Response:
    let raw = __http_headers()
    var h: {Str: Str} = {}
    var i = 0
    while i + 1 < raw.len():
        let k = raw[i]
        let before = h[k]
        if before != none:
            h[k] = before + ", " + raw[i + 1]
        else:
            h[k] = raw[i + 1]
        i += 2
    return Response(status: status, headers: h, body: __http_body())

# Sends a request with the method, URL, headers and body all specified.
# Redirects (301, 302 ...) are followed. 404 and 500 are responses too, not errors.
# An error happens only when the connection itself fails.
fn http_request(method: Str, url: Str, headers: {Str: Str}, body: Str) -> !Response:
    var flat: [Str] = []
    for k in headers.keys():
        flat.push(k)
        flat.push(headers[k] else "")
    let status = __http(method, url, flat, body)
    if status < 0:
        return error(__net_error())
    return __response(status)

fn http_get(url: Str) -> !Response:
    return http_request("GET", url, {}, "")

# If the body starts with `{` or `[` it is sent as JSON, otherwise as plain text.
# To send another content type, use http_request and set the "content-type" header yourself.
fn http_post(url: Str, body: Str) -> !Response:
    return http_request("POST", url, {}, body)

# Encodes text so it can go into a URL. `url_encode("김 밥&")` → "%EA%B9%80%20%EB%B0%A5%26"
fn url_encode(text: Str) -> Str:
    return __url_encode(text)

# Maximum time to wait (seconds). Defaults to 30 seconds.
fn set_timeout(seconds: Float):
    __net_timeout(seconds)

# ---- TCP connections ----

struct Conn:
    id: Int

    # Sends text.
    fn send(self, text: Str) -> !Unit:
        if __net_send(self.id, text) < 0:
            return error(__net_error())

    # Receives whatever has arrived (up to 64KB). "" if the peer closed the connection.
    fn recv(self) -> !Str:
        let s = __net_recv(self.id, 65536)
        let e = __net_error()
        if e != "":
            return error(e)
        return s

    # Receives one line, including the trailing newline. "" if the peer closed the connection.
    fn recv_line(self) -> !Str:
        let s = __net_recv_line(self.id)
        let e = __net_error()
        if e != "":
            return error(e)
        return s

    # Receives exactly n bytes. If the peer closes first, returns only what was received.
    fn recv_n(self, n: Int) -> !Str:
        let s = __net_recv_n(self.id, n)
        let e = __net_error()
        if e != "":
            return error(e)
        return s

    # The peer's address (like "127.0.0.1:51234").
    fn peer(self) -> Str:
        return __net_peer(self.id)

    fn close(self):
        __net_close(self.id)

fn connect(host: Str, port: Int) -> !Conn:
    let id = __net_open(host, port, false)
    if id < 0:
        return error(__net_error())
    return Conn(id: id)

# Secure connection (TLS). The certificate is verified.
fn connect_tls(host: Str, port: Int) -> !Conn:
    let id = __net_open(host, port, true)
    if id < 0:
        return error(__net_error())
    return Conn(id: id)

# ---- Servers ----

struct Server:
    id: Int

    # Waits until someone connects, then returns that connection.
    fn accept(self) -> !Conn:
        let c = __net_accept(self.id)
        if c < 0:
            return error(__net_error())
        return Conn(id: c)

    # Waits for the next HTTP request and returns it. Clients that send malformed requests are skipped.
    # Answer each request with `req.respond(...)`. An error happens only when the server has been closed.
    fn next_request(self) -> !Request:
        while true:
            let c = try self.accept()
            let req = read_request(c) catch e:
                c.close()
                continue
            return req
        return error("")

    # The port actually opened. Useful after listen(0) opened any free port.
    fn port(self) -> Int:
        return __net_port(self.id)

    fn close(self):
        __net_close(self.id)

# Opens a port and waits for connections. To accept only from this machine, use listen_on("127.0.0.1", port).
fn listen(port: Int) -> !Server:
    return listen_on("", port)

fn listen_on(host: Str, port: Int) -> !Server:
    let id = __net_listen(host, port)
    if id < 0:
        return error(__net_error())
    return Server(id: id)

# ---- https server ----

# Opens a secure (https) port. The certificate (cert) and private key (key) are paths to PEM files.
# Accepted connections (`accept`) are already secure, so just use `send`/`recv` as usual.
# To create a test certificate:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj /CN=localhost
fn listen_tls(port: Int, cert: Str, key: Str) -> !Server:
    return listen_tls_on("", port, cert, key)

fn listen_tls_on(host: Str, port: Int, cert: Str, key: Str) -> !Server:
    let id = __net_listen_tls(host, port, cert, key)
    if id < 0:
        return error(__net_error())
    return Server(id: id)

# Turns %XX in a URL back into the original characters. `url_decode("%EA%B9%80+%EB%B0%A5")` → "김 밥"
fn url_decode(text: Str) -> Str:
    return __net_url_decode(text)

# ---- HTTP server ----

# One request sent by a client.
struct Request:
    method: Str               # "GET", "POST" ...
    path: Str                 # "/hello" (without the part after ?)
    query: {Str: Str}         # {"name": "kim"} for "/hello?name=kim"
    headers: {Str: Str}       # names are lowercase
    body: Str
    conn: Conn

    # Header names are case-insensitive. none if missing.
    fn header(self, name: Str) -> ?Str:
        return self.headers[name.lower()]

    # Responds and closes the connection. A body starting with `{` or `[` is sent as JSON, `<` as HTML, anything else as plain text.
    fn respond(self, status: Int, body: Str) -> !Unit:
        return self.respond_with(status, {}, body)

    # Responds with headers you set yourself. Example: {"content-type": "image/png"}
    fn respond_with(self, status: Int, headers: {Str: Str}, body: Str) -> !Unit:
        var out = f"HTTP/1.1 {status} {__status_text(status)}\r\n"
        var has_type = false
        for k in headers.keys():
            if k.lower() == "content-type":
                has_type = true
            out += k + ": " + (headers[k] else "") + "\r\n"
        if not has_type:
            out += "content-type: " + __guess_type(body) + "\r\n"
        out += f"content-length: {__byte_len(body)}\r\nconnection: close\r\n\r\n"
        out += body
        self.conn.send(out) catch e:
            self.conn.close()
            return error(e)
        self.conn.close()

fn __status_text(status: Int) -> Str:
    let names: {Int: Str} = {200: "OK", 201: "Created", 204: "No Content", 301: "Moved Permanently",
        302: "Found", 304: "Not Modified", 400: "Bad Request", 401: "Unauthorized", 403: "Forbidden",
        404: "Not Found", 405: "Method Not Allowed", 409: "Conflict", 413: "Payload Too Large",
        500: "Internal Server Error", 503: "Service Unavailable"}
    return names[status] else "Status"

fn __guess_type(body: Str) -> Str:
    let t = body.strip()
    if t.starts_with("{") or t.starts_with("["):
        return "application/json"
    if t.starts_with("<"):
        return "text/html; charset=utf-8"
    return "text/plain; charset=utf-8"

# Number of bytes, not characters (a Korean character is 3 bytes).
fn __byte_len(s: Str) -> Int:
    return __net_byte_len(s)

fn __parse_query(q: Str) -> {Str: Str}:
    var out: {Str: Str} = {}
    if q == "":
        return out
    for part in q.split("&"):
        if part == "":
            continue
        let eq = part.find("=")
        if eq < 0:
            out[url_decode(part)] = ""
        else:
            out[url_decode(part.slice(0, eq))] = url_decode(part.slice(eq + 1, part.len()))
    return out

# Reads one request from a connection.
fn read_request(conn: Conn) -> !Request:
    let first = try conn.recv_line()
    let words = first.strip().split(" ")
    if words.len() < 3 or not words[2].starts_with("HTTP/"):
        return error("HTTP 요청이 아닙니다" if __ko() else "not an HTTP request")
    var headers: {Str: Str} = {}
    while true:
        let line = try conn.recv_line()
        let t = line.strip()
        if t == "":
            break
        let colon = t.find(":")
        if colon > 0:
            headers[t.slice(0, colon).strip().lower()] = t.slice(colon + 1, t.len()).strip()
    var body = ""
    let cl = headers["content-length"]
    if cl != none:
        let n = int(cl) catch e:
            return error("content-length 가 숫자가 아닙니다" if __ko() else "content-length is not a number")
        body = try conn.recv_n(n)
    let target = words[1]
    let q = target.find("?")
    var path = target
    var query: {Str: Str} = {}
    if q >= 0:
        path = target.slice(0, q)
        query = __parse_query(target.slice(q + 1, target.len()))
    return Request(method: words[0].upper(), path: url_decode(path), query: query, headers: headers, body: body, conn: conn)
