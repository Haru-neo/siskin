# An example using dictionaries, regular expressions and JSON together.
# Reads a log, counts lines per level, and outputs the result as JSON.
from std.re import groups, test
from std.json import jdict, jint, jstr, jlist, stringify, parse

fn main() -> !Unit:
    let log = [
        "2026-09-19 10:02 ERROR connection lost",
        "2026-09-19 10:03 INFO reconnected",
        "2026-09-19 10:07 WARN slow response",
        "2026-09-19 10:09 ERROR request timed out",
        "garbage line",
    ]

    # ---- Split lines with a regular expression ----
    let pattern = r"^(\d+-\d+-\d+) (\d+:\d+) (\w+) (.+)$"

    # ---- Count with a dictionary ----
    var counts: {Str: Int} = {}
    var first: {Str: Str} = {}

    for line in log:
        if not test(pattern, line):
            print("skipped: " + line + "\n")
            continue
        # groups() returns [whole match, first group, second, ...].
        let g = groups(pattern, line)
        let level = g[3]
        let message = g[4]

        let c = counts[level]
        if c == none:
            counts[level] = 1
            first[level] = message
        else:
            counts[level] = c + 1

    print("counts: " + str(counts) + "\n")

    # ---- Output as JSON ----
    let out = jdict()
    let levels = jlist()
    for level in counts.keys():
        let one = jdict()
        one.set("level", jstr(level))
        let n = counts[level]
        if n != none:
            one.set("count", jint(n))
        let m = first[level]
        if m != none:
            one.set("first", jstr(m))
        levels.push(one)
    out.set("total", jint(log.len()))
    out.set("levels", levels)

    let text = stringify(out)
    print("JSON: " + text + "\n")

    # ---- Read it back to check ----
    let back = try parse(text)
    let ls = back.get("levels")
    if ls != none:
        print("read back: " + str(ls.len()) + " levels\n")
    return
