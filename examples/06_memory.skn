# Three memory tiers — go only as low as you need, within the same program.

fn main():
    # ---- Level 0: just use it. No need to think about freeing. ----
    var names = ["Haru", "Mika"]
    names.push("Ruby")
    print("Level 0 — " + str(names) + "\n")

    # ---- Level 1: arena. Everything is freed at once when the block ends. ----
    with arena a:
        var xs = a.list[Int]()
        var i = 0
        while i < 6:
            xs.push(i * i)
            i = i + 1
        print("Level 1 — " + str(xs) + "\n")
    # All memory held by a is gone at this point.

    # ---- Level 2: raw pointers. The same freedom as C. ----
    unsafe:
        let p = alloc[Int](4)      # memory for 4 slots
        p[0] = 10
        p[1] = 20
        p[2] = p[0] + p[1]

        let q = p + 1              # pointer arithmetic: one slot further
        print("Level 2 — q[0]=" + str(q[0]) + ", q[1]=" + str(q[1]) + "\n")

        free(p)                    # the only place you free manually

    # You can also use raw memory inside an arena.
    # Then you do not call free; it is released together at the end of the block.
    with arena a2:
        unsafe:
            let buf = a2.alloc[Int](3)
            buf[0] = 7
            buf[2] = buf[0] * 3
            print("Level 1+2 — buf[2]=" + str(buf[2]) + "\n")
