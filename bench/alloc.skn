# Benchmark that measures allocation itself.
# 2000 "requests", each using 1000 small blocks.
# Arena: allocating just bumps a pointer forward. Everything is freed at once when the request ends.
fn main():
    let reqs = 2000
    let per = 1000
    let total = 0
    let r = 0
    while r < reqs:
        with arena a:
            unsafe:
                let i = 0
                while i < per:
                    let p = a.alloc[Int](8)
                    p[0] = i
                    p[7] = i + 1
                    total = total + p[0] + p[7]
                    i = i + 1
        r = r + 1
    print(str(total) + "\n")
