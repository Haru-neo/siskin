# Closure basics
fn apply(f: (Int) -> Int, x: Int) -> Int:
    return f(x)

fn make_adder(n: Int) -> (Int) -> Int:
    return fn(x): x + n

fn map[T, U](xs: [T], f: (T) -> U) -> [U]:
    var out: [U] = []
    for x in xs:
        out.push(f(x))
    return out

fn filter[T](xs: [T], keep: (T) -> Bool) -> [T]:
    var out: [T] = []
    for x in xs:
        if keep(x):
            out.push(x)
    return out

fn twice(x: Int) -> Int:
    return x * 2

fn main():
    let k = 3
    let times_k = fn(x: Int): x * k
    print(f"{times_k(5)}\n")
    print(f"{apply(fn(x): x + 100, 1)}\n")
    let add10 = make_adder(10)
    print(f"{add10(5)} {make_adder(1)(1)}\n")
    let nums = [1, 2, 3, 4, 5, 6]
    let limit = 3
    print(f"{filter(nums, fn(x): x > limit)}\n")
    print(f"{map(nums, fn(x): x * k)}\n")
    let names = map(nums, fn(x): "#" + str(x))
    print(f"{names}\n")
    # A named function is a value too
    print(f"{apply(twice, 21)}\n")
    # Changing an outer value after creation: the closure keeps the value from creation time
    var base = 1
    let g = fn(x: Int): x + base
    base = 100
    print(f"{g(1)} {base}\n")
    # Nested function (multi-line) + recursion
    let prefix = "value"
    fn describe(n: Int) -> Str:
        if n <= 0:
            return prefix
        return describe(n - 1) + "!"
    print(describe(3) + "\n")
    # Capturing a list, then modifying the original: the capture is unchanged
    var xs = [1, 2]
    let count = fn(): xs.len()
    xs.push(3)
    print(f"{count()} {xs.len()}\n")
    # A list of functions
    let ops: [(Int) -> Int] = [fn(x: Int): x + 1, fn(x: Int): x * x, twice]
    for op in ops:
        print(f"{op(7)} ")
    print("\n")
    # A closure inside a closure
    let outer = fn(a: Int): fn(b: Int): a + b + k
    print(f"{outer(1)(2)}\n")
    let say = fn(s: Str): print(s + "\n")
    say("hello")
