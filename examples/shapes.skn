# The file that 16_modules.skn imports. This file itself has no main.

struct Point:
    x: Float
    y: Float

enum Shape:
    Circle(center: Point, r: Float)
    Box(corner: Point, w: Float, h: Float)

    fn area(self) -> Float:
        match self:
            case Circle(c, r):
                return _PI * r * r
            case Box(c, w, h):
                return w * h

# Names starting with `_` are used only inside this file.
let _PI = 3.14159

fn unit_circle() -> Shape:
    return Circle(center: Point(x: 0.0, y: 0.0), r: 1.0)

fn describe(s: Shape) -> Str:
    return f"area {s.area():.2f}"
