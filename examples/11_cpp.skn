# Import a C++ library.
# C++ mangles names internally and has things like classes and virtual functions,
# so it cannot be called directly. Siskin builds the bridge in between automatically.
#
# With `also` you don't even need to build the library beforehand.

import cpp "shapes.hpp" from "cpplib" also "cpplib/shapes.cpp"

fn main():
    # Create a class with <name>_new, destroy it with <name>_delete
    let circle = geo_Circle_new(2.0)

    print("area     = " + str(geo_Circle_area(circle)) + "\n")
    print("radius   = " + str(geo_Circle_radius(circle)) + "   <- a function defined only in the header\n")

    geo_Circle_grow(circle, 1.0)
    print("grown    = " + str(geo_Circle_area(circle)) + "\n")

    # std::string becomes a Siskin string.
    print("kind     = " + geo_Circle_kind(circle) + "\n")
    # Asking through the parent class, the child answers (virtual function).
    print("virtual  = " + geo_Shape_kind(circle) + "\n")

    print(geo_greet("Haru") + "\n")
    print("hypot    = " + str(geo_hypot2(3.0, 4.0)) + "\n")

    geo_Circle_delete(circle)
