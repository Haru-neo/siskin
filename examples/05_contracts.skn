# 계약(requires/ensures)과 doctest — AI가 생성한 코드를 스스로 검증하는 장치

fn div(a: Int, b: Int) -> Int:
    """
    정수 나눗셈입니다.

    >>> div(7, 2)
    3
    >>> div(-9, 3)
    -3
    """
    requires b != 0
    ensures result * b <= a
    return a / b

fn slug(s: Str) -> Str:
    """
    공백을 하이픈으로 바꾸고 소문자로 만듭니다.

    >>> slug("Hello World")
    "hello-world"
    >>> slug("Siskin Lang")
    "siskin-lang"
    """
    return s.lower().replace(" ", "-")

fn main():
    print(f"{div(7, 2)}\n")
    print(f"{slug("Hello World")}\n")
    print("이제 사전 조건을 일부러 깨뜨립니다:\n")
    print(f"{div(1, 0)}\n")
