# Contracts (requires/ensures) and doctests — a way for AI-generated code to check itself

fn div(a: Int, b: Int) -> Int:
    """
    Integer division.

    >>> div(7, 2)
    3
    >>> div(-9, 3)
    -3
    """
    requires b != 0
    ensures result * b <= a
    return a / b

fn slug(s: Str) -> Str:
    """
    Replaces spaces with hyphens and lowercases the text.

    >>> slug("Hello World")
    "hello-world"
    >>> slug("Siskin Lang")
    "siskin-lang"
    """
    return s.lower().replace(" ", "-")

fn main():
    print(f"{div(7, 2)}\n")
    print(f"{slug("Hello World")}\n")
    print("Now we break the precondition on purpose:\n")
    print(f"{div(1, 0)}\n")
