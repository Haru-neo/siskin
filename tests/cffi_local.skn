# Test importing a C header and compiling it along (uses a small C file so no per-OS library needs to be installed)
import c "counter.h" from "clib" also "clib/counter.c"
import c "string.h"

fn main():
    let c = counter_new(10)
    counter_add(c, 5)
    counter_add(c, -3)
    print(f"count = {counter_get(c)}\n")
    counter_free(c)
    print(f"scale = {scale(1.5, 4.0)}\n")
    print(greet() + "\n")
    print(f"strlen = {strlen("siskin")}\n")
