# A tour of the standard library.
from std.math import sqrt, sin, pi, round
from std.random import seed, rand_int
from std.fs import write_text, read_text, exists, remove

fn main() -> !Unit:
    # ---- Math ----
    print("√2 = " + str(sqrt(2.0)) + "\n")
    print("pi = " + str(round(pi() * 100.0)) + " / 100\n")
    print("sin(pi/2) = " + str(sin(pi() / 2.0)) + "\n")

    # ---- Random numbers (with a fixed seed you always get the same values) ----
    seed(2026)
    print("five dice rolls:")
    var i = 0
    while i < 5:
        print(" " + str(rand_int(1, 7)))
        i = i + 1
    print("\n")

    # ---- Lists ----
    var xs = [5, 3, 9, 1, 7]
    xs.sort()
    print("sorted: " + str(xs) + "\n")
    print("sum: " + str(sum(xs)) + ", 9 is at index " + str(xs.index_of(9)) + "\n")
    print("first three: " + str(xs.slice(0, 3)) + "\n")

    # ---- Strings (a Korean syllable counts as one character) ----
    let s = "안녕하세요 미카"
    print("characters: " + str(s.len()) + "\n")
    print("first two characters: " + s.slice(0, 2) + "\n")
    print("position of '미카': " + str(s.find("미카")) + "\n")
    print("repeat: " + "-".repeat(20) + "\n")

    # ---- Files ----
    let path = "/tmp/siskin_example.txt"
    try write_text(path, "hello\n")
    print("read back: " + (try read_text(path)))
    try remove(path)
    print("still there after delete? " + str(exists(path)) + "\n")
    return
