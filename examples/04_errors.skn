# ?T and !T — no null and no exceptions

struct User:
    id: Int
    name: Str

fn find(users: [User], id: Int) -> ?User:
    for u in users:
        if u.id == id:
            return u
    return none

fn parse_age(text: Str) -> !Int:
    let n = try int(text)
    if n < 0:
        return error("age cannot be negative")
    return n

fn main():
    let users = [User(id: 1, name: "Haru"), User(id: 2, name: "Mika")]

    let found = find(users, 2)
    if found != none:
        print(f"found: {found.name}\n")

    let missing = find(users, 99)
    if missing == none:
        print("no user 99\n")

    let age = parse_age("34") catch e:
        print(f"failed: {e}\n")
        return
    print(f"age {age}\n")

    let bad = parse_age("thirty-four") catch e:
        print(f"failed: {e}\n")
        return
    print(f"this line never runs {bad}\n")
