# 진짜 데이터베이스(SQLite)를 Siskin 에서 씁니다.
# 헤더 한 줄만 적으면 sqlite3 함수 280여 개가 전부 열립니다.

import c "sqlite3.h" link "sqlite3"

# sqlite 가 찾은 결과를 한 줄씩 이 함수에 넘겨 줍니다.
# 0 을 돌려주면 "계속", 0 이 아니면 "그만".
fn 한줄씩(ctx: Int, 칸수: Int, 값들: Int, 이름들: Int) -> Int:
    var i = 0
    var line = "  "
    unsafe:
        # 값들/이름들은 C 가 준 주소입니다. cstr 로 글자열을 꺼냅니다.
        while i < 칸수:
            line = line + cstr(ptr_get(이름들, i)) + "=" + cstr(ptr_get(값들, i)) + "  "
            i = i + 1
    print(line + "\n")
    return 0

fn main():
    # sqlite3_open 은 "여기에 결과를 넣어 달라"는 자리를 받습니다.
    # 그런 자리는 Siskin 에서 그냥 var 변수를 넘기면 됩니다.
    var db = 0
    var err = 0
    if sqlite3_open(":memory:", db) != 0:
        print("열기 실패: " + sqlite3_errmsg(db) + "\n")
        return

    sqlite3_exec(db, "create table 사람(이름 text, 나이 int)", 한줄씩, 0, err)
    sqlite3_exec(db, "insert into 사람 values('하루',20),('미카',3)", 한줄씩, 0, err)

    print("sqlite 버전 = " + sqlite3_libversion() + "\n")
    print("표에 들어 있는 것:\n")
    sqlite3_exec(db, "select * from 사람 order by 나이", 한줄씩, 0, err)

    sqlite3_close(db)
