# Closure edge cases
struct Button:
    label: Str
    on_click: (Str) -> Str

    fn click(self) -> Str:
        return self.on_click(self.label)

struct Counter:
    step: Int

    fn stepper(self) -> (Int) -> Int:
        return fn(x: Int): x + self.step

fn compose(f: (Int) -> Int, g: (Int) -> Int) -> (Int) -> Int:
    return fn(x: Int): g(f(x))

fn find_first(xs: [Int], ok: (Int) -> Bool) -> ?Int:
    for x in xs:
        if ok(x):
            return x
    return none

fn sort_by(xs: [Str], key: (Str) -> Int) -> [Str]:
    var out = xs
    var i = 1
    while i < out.len():
        var j = i
        while j > 0 and key(out[j - 1]) > key(out[j]):
            let t = out[j - 1]
            out[j - 1] = out[j]
            out[j] = t
            j -= 1
        i += 1
    return out

fn main():
    let greeting = "Hello, "
    let b = Button(label: "Haru", on_click: fn(s: Str): greeting + s)
    print(b.click() + "\n")
    let c = Counter(step: 5)
    let st = c.stepper()
    print(f"{st(10)}\n")
    let inc_then_double = compose(fn(x): x + 1, fn(x): x * 2)
    print(f"{inc_then_double(3)}\n")
    let maybe: ?Int = 7
    if maybe != none:
        let add_m = fn(x: Int): x + maybe
        print(f"{add_m(1)}\n")
    let min_len = 3
    let r = find_first([1, 2, 3, 4], fn(x): x >= min_len)
    if r != none:
        print(f"found {r}\n")
    let words = ["banana", "kiwi", "apple", "fig"]
    print(f"{sort_by(words, fn(w): w.len())}\n")
    var table: {Str: (Int) -> Int} = {}
    let k = 10
    table["add"] = fn(x: Int): x + k
    table["mul"] = fn(x: Int): x * k
    for name, f in table:
        print(f"{name} {f(3)}\n")
    # Recursive nested function + outer value
    let memo_base = 2
    fn power(n: Int) -> Int:
        if n == 0:
            return 1
        return memo_base * power(n - 1)
    print(f"{power(10)}\n")
    # A nested function calling another nested function
    fn sq(x: Int) -> Int:
        return x * x
    fn sum_sq(xs: [Int]) -> Int:
        var t = 0
        for x in xs:
            t += sq(x)
        return t
    print(f"{sum_sq([1, 2, 3])}\n")
    # A closure whose function returns Unit
    var log: [Str] = []
    let tag = "[log]"
    let fmt = fn(m: Str): tag + " " + m
    log.push(fmt("start"))
    log.push(fmt("end"))
    print(log.join("\n") + "\n")
