# std.net — 인터넷 연결 (HTTP 요청, TCP 연결, 서버).
# 이 파일은 컴파일러 안에 들어 있고, `import std.net` 을 쓰면 프로그램에 합쳐집니다.
# 네트워크는 운영체제와 직접 이야기해야 해서, 이 모듈을 쓰면 `siskin run` 도
# 조용히 네이티브로 컴파일해서 돌립니다(C 라이브러리를 쓸 때와 같습니다).

# ---- HTTP ----

struct Response:
    status: Int
    headers: {Str: Str}
    body: Str

    # 200~299 면 성공입니다.
    fn ok(self) -> Bool:
        return self.status >= 200 and self.status < 300

    # 헤더는 대소문자를 가리지 않습니다. 없으면 none.
    fn header(self, name: Str) -> ?Str:
        return self.headers[name.lower()]

fn __response(status: Int) -> Response:
    let raw = __http_headers()
    var h: {Str: Str} = {}
    var i = 0
    while i + 1 < raw.len():
        let k = raw[i]
        let before = h[k]
        if before != none:
            h[k] = before + ", " + raw[i + 1]
        else:
            h[k] = raw[i + 1]
        i += 2
    return Response(status: status, headers: h, body: __http_body())

# 요청 방법, 주소, 헤더, 본문을 모두 정해서 보냅니다.
# 다른 주소로 넘기면(301, 302 ...) 따라갑니다. 404 나 500 도 오류가 아니라 응답입니다.
# 오류는 연결 자체가 안 될 때만 납니다.
fn http_request(method: Str, url: Str, headers: {Str: Str}, body: Str) -> !Response:
    var flat: [Str] = []
    for k in headers.keys():
        flat.push(k)
        flat.push(headers[k] else "")
    let status = __http(method, url, flat, body)
    if status < 0:
        return error(__net_error())
    return __response(status)

fn http_get(url: Str) -> !Response:
    return http_request("GET", url, {}, "")

# 본문이 `{` 나 `[` 로 시작하면 JSON 으로, 아니면 글자로 보냅니다.
# 다른 종류로 보내려면 http_request 로 "content-type" 헤더를 직접 주세요.
fn http_post(url: Str, body: Str) -> !Response:
    return http_request("POST", url, {}, body)

# 주소에 넣을 수 있게 바꿉니다. `url_encode("김 밥&")` → "%EA%B9%80%20%EB%B0%A5%26"
fn url_encode(text: Str) -> Str:
    return __url_encode(text)

# 기다리는 최대 시간(초). 처음엔 30초입니다.
fn set_timeout(seconds: Float):
    __net_timeout(seconds)

# ---- TCP 연결 ----

struct Conn:
    id: Int

    # 글을 보냅니다.
    fn send(self, text: Str) -> !Unit:
        if __net_send(self.id, text) < 0:
            return error(__net_error())

    # 온 것을 받습니다(최대 64KB). 상대가 연결을 끊었으면 "".
    fn recv(self) -> !Str:
        let s = __net_recv(self.id, 65536)
        let e = __net_error()
        if e != "":
            return error(e)
        return s

    # 한 줄을 받습니다. 끝의 줄바꿈도 들어 있습니다. 상대가 연결을 끊었으면 "".
    fn recv_line(self) -> !Str:
        let s = __net_recv_line(self.id)
        let e = __net_error()
        if e != "":
            return error(e)
        return s

    # 정확히 n 바이트를 받습니다. 상대가 먼저 끊으면 받은 만큼만 줍니다.
    fn recv_n(self, n: Int) -> !Str:
        let s = __net_recv_n(self.id, n)
        let e = __net_error()
        if e != "":
            return error(e)
        return s

    # 상대의 주소 ("127.0.0.1:51234" 처럼).
    fn peer(self) -> Str:
        return __net_peer(self.id)

    fn close(self):
        __net_close(self.id)

fn connect(host: Str, port: Int) -> !Conn:
    let id = __net_open(host, port, false)
    if id < 0:
        return error(__net_error())
    return Conn(id: id)

# 보안 연결(TLS). 인증서를 확인합니다.
fn connect_tls(host: Str, port: Int) -> !Conn:
    let id = __net_open(host, port, true)
    if id < 0:
        return error(__net_error())
    return Conn(id: id)

# ---- 서버 ----

struct Server:
    id: Int

    # 누가 연결해 올 때까지 기다렸다가 그 연결을 줍니다.
    fn accept(self) -> !Conn:
        let c = __net_accept(self.id)
        if c < 0:
            return error(__net_error())
        return Conn(id: c)

    # 다음 HTTP 요청을 기다렸다가 줍니다. 요청을 잘못 보낸 손님은 건너뜁니다.
    # 요청마다 `req.respond(...)` 로 대답하세요. 오류는 서버가 닫혔을 때만 납니다.
    fn next_request(self) -> !Request:
        while true:
            let c = try self.accept()
            let req = read_request(c) catch e:
                c.close()
                continue
            return req
        return error("")

    # 실제로 열린 포트. listen(0) 으로 아무 포트나 열었을 때 씁니다.
    fn port(self) -> Int:
        return __net_port(self.id)

    fn close(self):
        __net_close(self.id)

# 포트를 열고 연결을 기다립니다. 이 컴퓨터 안에서만 받으려면 listen_on("127.0.0.1", 포트).
fn listen(port: Int) -> !Server:
    return listen_on("", port)

fn listen_on(host: Str, port: Int) -> !Server:
    let id = __net_listen(host, port)
    if id < 0:
        return error(__net_error())
    return Server(id: id)

# ---- https 서버 ----

# 보안 포트(https)를 엽니다. 인증서(cert)와 비밀 열쇠(key)는 PEM 파일 경로입니다.
# 받은 연결(`accept`)은 이미 보안 연결이라 `send`/`recv` 를 그대로 쓰면 됩니다.
# 시험용 인증서 만들기:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj /CN=localhost
fn listen_tls(port: Int, cert: Str, key: Str) -> !Server:
    return listen_tls_on("", port, cert, key)

fn listen_tls_on(host: Str, port: Int, cert: Str, key: Str) -> !Server:
    let id = __net_listen_tls(host, port, cert, key)
    if id < 0:
        return error(__net_error())
    return Server(id: id)

# 주소의 %XX 를 원래 글자로 되돌립니다. `url_decode("%EA%B9%80+%EB%B0%A5")` → "김 밥"
fn url_decode(text: Str) -> Str:
    return __net_url_decode(text)

# ---- HTTP 서버 ----

# 손님이 보낸 요청 하나.
struct Request:
    method: Str               # "GET", "POST" ...
    path: Str                 # "/hello" (? 뒤는 빠짐)
    query: {Str: Str}         # "/hello?name=kim" 이면 {"name": "kim"}
    headers: {Str: Str}       # 이름은 소문자
    body: Str
    conn: Conn

    # 헤더는 대소문자를 가리지 않습니다. 없으면 none.
    fn header(self, name: Str) -> ?Str:
        return self.headers[name.lower()]

    # 대답하고 연결을 닫습니다. 본문이 `{` 나 `[` 로 시작하면 JSON, `<` 면 HTML, 아니면 글자로 보냅니다.
    fn respond(self, status: Int, body: Str) -> !Unit:
        return self.respond_with(status, {}, body)

    # 헤더를 직접 정해서 대답합니다. 예: {"content-type": "image/png"}
    fn respond_with(self, status: Int, headers: {Str: Str}, body: Str) -> !Unit:
        var out = f"HTTP/1.1 {status} {__status_text(status)}\r\n"
        var has_type = false
        for k in headers.keys():
            if k.lower() == "content-type":
                has_type = true
            out += k + ": " + (headers[k] else "") + "\r\n"
        if not has_type:
            out += "content-type: " + __guess_type(body) + "\r\n"
        out += f"content-length: {__byte_len(body)}\r\nconnection: close\r\n\r\n"
        out += body
        self.conn.send(out) catch e:
            self.conn.close()
            return error(e)
        self.conn.close()

fn __status_text(status: Int) -> Str:
    let names: {Int: Str} = {200: "OK", 201: "Created", 204: "No Content", 301: "Moved Permanently",
        302: "Found", 304: "Not Modified", 400: "Bad Request", 401: "Unauthorized", 403: "Forbidden",
        404: "Not Found", 405: "Method Not Allowed", 409: "Conflict", 413: "Payload Too Large",
        500: "Internal Server Error", 503: "Service Unavailable"}
    return names[status] else "Status"

fn __guess_type(body: Str) -> Str:
    let t = body.strip()
    if t.starts_with("{") or t.starts_with("["):
        return "application/json"
    if t.starts_with("<"):
        return "text/html; charset=utf-8"
    return "text/plain; charset=utf-8"

# 글자 수가 아니라 바이트 수 (한글은 한 글자가 3바이트).
fn __byte_len(s: Str) -> Int:
    return __net_byte_len(s)

fn __parse_query(q: Str) -> {Str: Str}:
    var out: {Str: Str} = {}
    if q == "":
        return out
    for part in q.split("&"):
        if part == "":
            continue
        let eq = part.find("=")
        if eq < 0:
            out[url_decode(part)] = ""
        else:
            out[url_decode(part.slice(0, eq))] = url_decode(part.slice(eq + 1, part.len()))
    return out

# 연결 하나에서 요청 하나를 읽습니다.
fn read_request(conn: Conn) -> !Request:
    let first = try conn.recv_line()
    let words = first.strip().split(" ")
    if words.len() < 3 or not words[2].starts_with("HTTP/"):
        return error("HTTP 요청이 아닙니다" if __ko() else "not an HTTP request")
    var headers: {Str: Str} = {}
    while true:
        let line = try conn.recv_line()
        let t = line.strip()
        if t == "":
            break
        let colon = t.find(":")
        if colon > 0:
            headers[t.slice(0, colon).strip().lower()] = t.slice(colon + 1, t.len()).strip()
    var body = ""
    let cl = headers["content-length"]
    if cl != none:
        let n = int(cl) catch e:
            return error("content-length 가 숫자가 아닙니다" if __ko() else "content-length is not a number")
        body = try conn.recv_n(n)
    let target = words[1]
    let q = target.find("?")
    var path = target
    var query: {Str: Str} = {}
    if q >= 0:
        path = target.slice(0, q)
        query = __parse_query(target.slice(q + 1, target.len()))
    return Request(method: words[0].upper(), path: url_decode(path), query: query, headers: headers, body: body, conn: conn)
