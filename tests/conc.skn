import std.random

fn fib(n: Int) -> Int:
    if n < 2:
        return n
    return fib(n - 1) + fib(n - 2)

fn producer(ch: Chan[Int], n: Int):
    for i in range(n):
        ch.send(i * i)
    ch.close()

struct Job:
    id: Int
    words: [Str]

fn count(j: Job) -> (Int, Int):
    return (j.id, len(j.words))

fn risky(n: Int) -> !Int:
    if n < 0:
        return error("negative")
    return n * 10

fn main():
    # 1. 여러 계산을 동시에
    var tasks: [Task[Int]] = []
    for n in [20, 21, 22, 23]:
        tasks.push(spawn fib(n))
    var total = 0
    for t in tasks:
        total += t.wait()
    print(f"sum of fibs: {total}\n")

    # 2. 통로로 주고받기
    let ch = channel[Int]()
    let p = spawn producer(ch, 5)
    var got: [Int] = []
    for v in ch:
        got.push(v)
    p.wait()
    print(f"received {got}\n")

    # 3. 값은 복사되어 넘어갑니다
    var words = ["a", "b"]
    let t = spawn count(Job(id: 7, words: words))
    words.push("c")
    let (id, n) = t.wait()
    print(f"job {id} had {n} words, now {len(words)}\n")

    # 4. 크기 정한 통로, 여러 일꾼
    let jobs = channel[Int](2)
    let results = channel[Str]()
    fn worker(w: Int, jobs: Chan[Int], results: Chan[Str]):
        for j in jobs:
            results.send(f"{j * 2}")
    var ws: [Task[()]] = []
    for w in range(3):
        ws.push(spawn worker(w, jobs, results))
    for j in range(6):
        jobs.send(j)
    jobs.close()
    for w in ws:
        w.wait()
    results.close()
    var rs: [Str] = []
    for r in results:
        rs.push(r)
    rs.sort()
    print(f"results {rs}\n")

    # 5. 실패할 수 있는 작업
    let bad = spawn risky(-1)
    let good = spawn risky(4)
    let a = bad.wait() catch e:
        print(f"task failed: {e}\n")
        0
    let b = try_or(good)
    print(f"{a} {b}\n")

    # 6. 난수는 작업마다 다르지만 정해져 있습니다
    fn roll() -> Int:
        return random.rand_int(1, 100)
    let r1 = spawn roll()
    let r2 = spawn roll()
    print(f"rolls {r1.wait()} {r2.wait()} main {random.rand_int(1, 100)}\n")
    print(f"done? {r1.done()} {r1}\n")

fn try_or(t: Task[!Int]) -> Int:
    let v = t.wait() catch e:
        -1
    return v
