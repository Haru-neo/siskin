# Use a real database (SQLite) from Siskin.
# A single header line opens up all 280-odd sqlite3 functions.

import c "sqlite3.h" link "sqlite3"

# sqlite passes each result row to this function, one at a time.
# Return 0 for "continue", anything else for "stop".
fn each_row(ctx: Int, ncols: Int, values: Int, names: Int) -> Int:
    var i = 0
    var line = "  "
    unsafe:
        # values/names are addresses from C. Use cstr to get the strings out.
        while i < ncols:
            line = line + cstr(ptr_get(names, i)) + "=" + cstr(ptr_get(values, i)) + "  "
            i = i + 1
    print(line + "\n")
    return 0

fn main():
    # sqlite3_open takes a slot meaning "put the result here".
    # In Siskin you simply pass a var variable for such a slot.
    var db = 0
    var err = 0
    if sqlite3_open(":memory:", db) != 0:
        print("open failed: " + sqlite3_errmsg(db) + "\n")
        return

    sqlite3_exec(db, "create table people(name text, age int)", each_row, 0, err)
    sqlite3_exec(db, "insert into people values('Haru',20),('Mika',3)", each_row, 0, err)

    print("sqlite version = " + sqlite3_libversion() + "\n")
    print("rows in the table:\n")
    sqlite3_exec(db, "select * from people order by age", each_row, 0, err)

    sqlite3_close(db)
