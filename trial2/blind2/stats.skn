from std.fs import read_text

struct Student:
    name: Str
    total: Int
    count: Int

fn average(s: Student) -> Float:
    return float(s.total) / float(s.count)

fn main():
    let text = read_text("scores.csv") catch e:
        print("error: cannot read scores.csv\n")
        return
    let lines = text.split("\n")
    var students: {Str: Student} = {}
    var max_score = 0
    for i in range(len(lines)):
        if i == 0:
            continue
        let trimmed = lines[i].strip()
        if trimmed == "":
            continue
        let parts = trimmed.split(",")
        if len(parts) != 3:
            eprint("warning: bad row " + trimmed + "\n")
            continue
        let score = int(parts[2]) catch e:
            eprint("warning: bad score in row " + trimmed + "\n")
            continue
        let name = parts[0]
        var cur = students.get(name, Student(name: name, total: 0, count: 0))
        cur.total += score
        cur.count += 1
        students[name] = cur
        if score > max_score:
            max_score = score
    var list: [Student] = []
    for k, v in students:
        list.push(v)
    list.sort_by(fn(s: Student): -average(s))
    for s in list:
        print(f"{s.name}: {average(s):.1f}\n")
    print(f"max score: {max_score}\n")
