# 16_modules.skn 가 가져다 쓰는 파일입니다. 이 파일 자체에는 main 이 없습니다.

struct Point:
    x: Float
    y: Float

enum Shape:
    Circle(center: Point, r: Float)
    Box(corner: Point, w: Float, h: Float)

    fn area(self) -> Float:
        match self:
            case Circle(c, r):
                return _PI * r * r
            case Box(c, w, h):
                return w * h

# `_` 로 시작하는 이름은 이 파일 안에서만 씁니다.
let _PI = 3.14159

fn unit_circle() -> Shape:
    return Circle(center: Point(x: 0.0, y: 0.0), r: 1.0)

fn describe(s: Shape) -> Str:
    return f"넓이 {s.area():.2f}"
