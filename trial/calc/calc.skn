# calc — a small calculator REPL.
#
# Reads lines from standard input until EOF. Each line is either an expression
# (`1 + 2 * 3`) or an assignment (`x = 3 * (2 + y)`). Variables persist between lines.
# Errors are reported as `error: <message> at column N` and the REPL keeps going.
from std.fs import read_text
from std.math import floor, pow

# ---------------------------------------------------------------- tokens

enum Tok:
    TNum(value: Float)
    TIdent(name: Str)
    TSym(sym: Str)
    TEnd

struct Token:
    kind: Tok
    text: Str
    col: Int

fn is_digit(c: Str) -> Bool:
    return "0123456789".contains(c)

fn is_ident_start(c: Str) -> Bool:
    return "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ_".contains(c)

fn tokenize(line: Str) -> ![Token]:
    var toks: [Token] = []
    var i = 0
    let n = line.len()
    while i < n:
        let c = line[i]
        let col = i + 1
        if c == " " or c == "\t" or c == "\r":
            i += 1
        elif is_digit(c) or (c == "." and i + 1 < n and is_digit(line[i + 1])):
            let start = i
            var seen_dot = false
            while i < n and (is_digit(line[i]) or (line[i] == "." and not seen_dot)):
                if line[i] == ".":
                    seen_dot = true
                i += 1
            let text = line.slice(start, i)
            let value = float(text) catch e:
                return error(f"bad number '{text}' at column {col}")
            toks.push(Token(kind: TNum(value: value), text: text, col: col))
        elif is_ident_start(c):
            let start = i
            while i < n and (is_ident_start(line[i]) or is_digit(line[i])):
                i += 1
            let name = line.slice(start, i)
            toks.push(Token(kind: TIdent(name: name), text: name, col: col))
        elif "+-*/%^()=".contains(c):
            toks.push(Token(kind: TSym(sym: c), text: c, col: col))
            i += 1
        else:
            return error(f"unknown character '{c}' at column {col}")
    toks.push(Token(kind: TEnd, text: "end of line", col: n + 1))
    return toks

fn show_tokens(line: Str) -> Str:
    """
    Renders the tokens of a line as `text@column`, for testing the tokenizer.

    >>> show_tokens("x = 3 * (2 + y)")
    "x@1 =@3 3@5 *@7 (@9 2@10 +@12 y@14 )@15 end@16"
    >>> show_tokens("3.25+.5")
    "3.25@1 +@5 .5@6 end@8"
    >>> show_tokens("-rate_2^2 % 7")
    "-@1 rate_2@2 ^@8 2@9 %@11 7@13 end@14"
    >>> show_tokens("")
    "end@1"
    >>> show_tokens("2 $ 3")
    "error: unknown character '$' at column 3"
    """
    let toks = tokenize(line) catch e:
        return "error: " + e
    var parts: [Str] = []
    for t in toks:
        match t.kind:
            case TEnd:
                parts.push(f"end@{t.col}")
            case TNum(value):
                parts.push(f"{t.text}@{t.col}")
            case TIdent(name):
                parts.push(f"{name}@{t.col}")
            case TSym(sym):
                parts.push(f"{sym}@{t.col}")
    return parts.join(" ")

# ---------------------------------------------------------------- AST

enum Expr:
    Num(value: Float)
    Var(name: Str, col: Int)
    Neg(operand: Expr)
    Bin(op: Str, left: Expr, right: Expr, col: Int)

enum Stmt:
    Assign(name: Str, value: Expr)
    Show(value: Expr)

# ---------------------------------------------------------------- parser
#
# statement := IDENT '=' expr | expr
# expr      := term (('+' | '-') term)*
# term      := unary (('*' | '/' | '%') unary)*
# unary     := '-' unary | power
# power     := primary ('^' unary)?          (right-associative, so 2^3^2 = 2^9)
# primary   := NUMBER | IDENT | '(' expr ')'

struct Parser:
    toks: [Token]
    pos: Int

    fn peek(self) -> Token:
        return self.toks[self.pos]

    fn sym_at(self, k: Int) -> Str:
        if k >= self.toks.len():
            return ""
        match self.toks[k].kind:
            case TSym(sym):
                return sym
            case _:
                return ""

    fn advance(inout self) -> Token:
        let t = self.toks[self.pos]
        if self.pos < self.toks.len() - 1:
            self.pos += 1
        return t

    fn statement(inout self) -> !Stmt:
        match self.peek().kind:
            case TIdent(name):
                if self.sym_at(self.pos + 1) == "=":
                    self.advance()
                    self.advance()
                    let value = try self.expr()
                    try self.finish()
                    return Assign(name: name, value: value)
                return try self.show()
            case _:
                return try self.show()

    fn show(inout self) -> !Stmt:
        let value = try self.expr()
        try self.finish()
        return Show(value: value)

    fn finish(self) -> !Unit:
        let t = self.peek()
        match t.kind:
            case TEnd:
                return
            case TSym(sym):
                if sym == ")":
                    return error(f"unbalanced parentheses: unmatched ')' at column {t.col}")
                return error(f"unexpected '{sym}' at column {t.col}")
            case TNum(value):
                return error(f"unexpected number '{t.text}' at column {t.col}")
            case TIdent(name):
                return error(f"unexpected name '{name}' at column {t.col}")

    fn expr(inout self) -> !Expr:
        var left = try self.term()
        while self.sym_at(self.pos) == "+" or self.sym_at(self.pos) == "-":
            let op = self.advance()
            let right = try self.term()
            left = Bin(op: op.text, left: left, right: right, col: op.col)
        return left

    fn term(inout self) -> !Expr:
        var left = try self.unary()
        while self.sym_at(self.pos) == "*" or self.sym_at(self.pos) == "/" or self.sym_at(self.pos) == "%":
            let op = self.advance()
            let right = try self.unary()
            left = Bin(op: op.text, left: left, right: right, col: op.col)
        return left

    fn unary(inout self) -> !Expr:
        if self.sym_at(self.pos) == "-":
            self.advance()
            let operand = try self.unary()
            return Neg(operand: operand)
        return try self.power()

    fn power(inout self) -> !Expr:
        let base = try self.primary()
        if self.sym_at(self.pos) == "^":
            let op = self.advance()
            let exponent = try self.unary()
            return Bin(op: "^", left: base, right: exponent, col: op.col)
        return base

    fn primary(inout self) -> !Expr:
        let t = self.advance()
        match t.kind:
            case TNum(value):
                return Num(value: value)
            case TIdent(name):
                return Var(name: name, col: t.col)
            case TSym(sym):
                if sym == "(":
                    let inner = try self.expr()
                    if self.sym_at(self.pos) != ")":
                        let next = self.peek()
                        match next.kind:
                            case TEnd:
                                return error(f"unbalanced parentheses: '(' is never closed at column {t.col}")
                            case _:
                                return error(f"expected ')' but found '{next.text}' at column {next.col}")
                    self.advance()
                    return inner
                if sym == ")":
                    return error(f"unbalanced parentheses: unmatched ')' at column {t.col}")
                return error(f"expected a number, name or '(' but found '{sym}' at column {t.col}")
            case TEnd:
                return error(f"unexpected end of line at column {t.col}")

fn parse_line(line: Str) -> !Stmt:
    let toks = try tokenize(line)
    var p = Parser(toks: toks, pos: 0)
    return try p.statement()

# ---------------------------------------------------------------- evaluation

fn evaluate(e: Expr, vars: {Str: Float}) -> !Float:
    match e:
        case Num(value):
            return value
        case Var(name, col):
            let v = vars[name]
            if v == none:
                return error(f"unknown variable '{name}' at column {col}")
            return v
        case Neg(operand):
            let v = try evaluate(operand, vars)
            return -v
        case Bin(op, left, right, col):
            let a = try evaluate(left, vars)
            let b = try evaluate(right, vars)
            if op == "+":
                return a + b
            if op == "-":
                return a - b
            if op == "*":
                return a * b
            if op == "/":
                if b == 0.0:
                    return error(f"division by zero at column {col}")
                return a / b
            if op == "%":
                if b == 0.0:
                    return error(f"division by zero (modulo) at column {col}")
                return a - b * float(floor(a / b))
            return pow(a, b)

fn fmt_num(v: Float) -> Str:
    """
    Whole numbers print without a fractional part.

    >>> fmt_num(14.0)
    "14"
    >>> fmt_num(-2.5)
    "-2.5"
    """
    let s = str(v)
    if s.ends_with(".0"):
        return s.slice(0, s.len() - 2)
    return s

# ---------------------------------------------------------------- REPL

fn main():
    let input = read_text("/dev/stdin") catch e:
        print(f"error: cannot read standard input: {e}\n")
        return
    var vars: {Str: Float} = {}
    for line in input.split("\n"):
        if line.strip() == "":
            continue
        let stmt = parse_line(line) catch e:
            print(f"error: {e}\n")
            continue
        match stmt:
            case Assign(name, value):
                let v = evaluate(value, vars) catch e:
                    print(f"error: {e}\n")
                    continue
                vars[name] = v
                print(f"{name} = {fmt_num(v)}\n")
            case Show(value):
                let v = evaluate(value, vars) catch e:
                    print(f"error: {e}\n")
                    continue
                print(fmt_num(v) + "\n")
