# Import a whole C library.
# Just name the header file (the library's description) and Siskin reads the functions in it for you.
# No need to declare functions one by one by hand.

import c "zlib.h" link "z"      # the zlib compression library
import c "string.h"             # C standard string functions (nothing to link)

fn main():
    let s = "hello siskin"

    # zlib's checksum. Gives the same value as Python's zlib.crc32.
    print("zlib version = " + zlibVersion() + "\n")
    print("crc32     = " + str(crc32(0, s, strlen(s))) + "\n")

    # The C standard library works as is, too.
    print("strlen(안녕) = " + str(strlen("안녕")) + " bytes\n")

    # strcmp returns a 32-bit integer in C. Siskin widens it to 64 bits.
    print("strcmp(a,b)  = " + str(strcmp("a", "b")) + "\n")

    # To see which functions are available, run in a terminal:  siskin ffi zlib.h --all
