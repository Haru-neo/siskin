# Internet: HTTP requests, and a small server
# (with std.net, `siskin run` also compiles natively and runs the result)
import std.net
from std.json import parse

fn main():
    # ---- Fetch JSON from the web ----
    let r = http_get("https://pypi.org/pypi/requests/json") catch e:
        print("could not reach the internet: " + e + "\n")
        return
    print(f"status {r.status}, ok? {r.ok()}\n")
    print("type: " + (r.header("Content-Type") else "?") + "\n")
    let data = parse(r.body) catch e:
        print("not JSON: " + e + "\n")
        return
    let info = data.get("info")
    if info != none:
        let name = info.get("name")
        if name != none:
            print("package name: " + (name.as_str() else "?") + "\n")

    # ---- A server and a client on this machine ----
    let server = listen_on("127.0.0.1", 0) catch e:      # 0 = any free port
        print(e + "\n")
        return
    let guest = connect("127.0.0.1", server.port()) catch e:
        print(e + "\n")
        return
    guest.send("hello\n") catch e:
        print(e + "\n")
    let conn = server.accept() catch e:
        print(e + "\n")
        return
    let line = conn.recv_line() catch e:
        ""
    conn.send("got it: " + line) catch e:
        print(e + "\n")
    conn.close()
    let answer = guest.recv() catch e:
        ""
    print("the client heard: " + answer)
    guest.close()
    server.close()
