# 수식 계산기 — 토큰 나누기 / 파싱 / 계산
from std.math import pow

enum Tok:
    Num(v: Float)
    Op(c: Str)
    LPar
    RPar

enum Node:
    Lit(v: Float)
    Bin(op: Str, l: Node, r: Node)
    Neg(e: Node)

# 파서는 "만든 가지"와 "다음 위치"를 같이 돌려줘야 한다.
# 튜플이 없고 위치를 고쳐 쓸 방법이 없어서 이 구조체를 만들었다.
struct Parsed:
    node: Node
    pos: Int

fn is_digit(c: Str) -> Bool:
    return c >= "0" and c <= "9"

fn tokenize(src: Str) -> ![Tok]:
    var out: [Tok] = []
    var i = 0
    while i < src.len():
        let c = src[i]
        if c == " ":
            i += 1
            continue
        if is_digit(c) or c == ".":
            var text = ""
            while i < src.len() and (is_digit(src[i]) or src[i] == "."):
                text += src[i]
                i += 1
            out.push(Num(v: try float(text)))
            continue
        if c == "(":
            out.push(LPar())
            i += 1
            continue
        if c == ")":
            out.push(RPar())
            i += 1
            continue
        if c == "+" or c == "-" or c == "*" or c == "/" or c == "^":
            out.push(Op(c: c))
            i += 1
            continue
        return error("모르는 글자 " + c)
    return out

fn op_at(toks: [Tok], i: Int) -> Str:
    if i >= toks.len():
        return ""
    match toks[i]:
        case Op(c):
            return c
        case Num(v):
            return ""
        case LPar:
            return "("
        case RPar:
            return ")"

# 단항: 숫자, 괄호, 앞에 붙은 마이너스
fn parse_unary(toks: [Tok], i: Int) -> !Parsed:
    if i >= toks.len():
        return error("수식이 갑자기 끝났습니다")
    if op_at(toks, i) == "-":
        let inner = try parse_unary(toks, i + 1)
        return Parsed(node: Neg(e: inner.node), pos: inner.pos)
    if op_at(toks, i) == "(":
        let inner = try parse_sum(toks, i + 1)
        if op_at(toks, inner.pos) != ")":
            return error("닫는 괄호가 없습니다")
        return Parsed(node: inner.node, pos: inner.pos + 1)
    match toks[i]:
        case Num(v):
            return Parsed(node: Lit(v: v), pos: i + 1)
        case Op(c):
            return error("숫자가 올 자리에 " + c + "가 왔습니다")
        case LPar:
            return error("괄호 처리 오류")
        case RPar:
            return error("여는 괄호 없이 )가 왔습니다")

# 거듭제곱: 오른쪽부터 묶는다 (2^3^2 = 2^9)
fn parse_pow(toks: [Tok], i: Int) -> !Parsed:
    let base = try parse_unary(toks, i)
    if op_at(toks, base.pos) == "^":
        let exp = try parse_pow(toks, base.pos + 1)
        return Parsed(node: Bin(op: "^", l: base.node, r: exp.node), pos: exp.pos)
    return base

# 곱셈과 나눗셈
fn parse_product(toks: [Tok], i: Int) -> !Parsed:
    var cur = try parse_pow(toks, i)
    while op_at(toks, cur.pos) == "*" or op_at(toks, cur.pos) == "/":
        let sym = op_at(toks, cur.pos)
        let rhs = try parse_pow(toks, cur.pos + 1)
        cur = Parsed(node: Bin(op: sym, l: cur.node, r: rhs.node), pos: rhs.pos)
    return cur

# 덧셈과 뺄셈
fn parse_sum(toks: [Tok], i: Int) -> !Parsed:
    var cur = try parse_product(toks, i)
    while op_at(toks, cur.pos) == "+" or op_at(toks, cur.pos) == "-":
        let sym = op_at(toks, cur.pos)
        let rhs = try parse_product(toks, cur.pos + 1)
        cur = Parsed(node: Bin(op: sym, l: cur.node, r: rhs.node), pos: rhs.pos)
    return cur

fn eval(n: Node) -> !Float:
    match n:
        case Lit(v):
            return v
        case Neg(e):
            let inner = try eval(e)
            return -inner
        case Bin(op, l, r):
            let a = try eval(l)
            let b = try eval(r)
            if op == "+":
                return a + b
            if op == "-":
                return a - b
            if op == "*":
                return a * b
            if op == "/":
                if b == 0.0:
                    return error("0으로 나눴습니다")
                return a / b
            if op == "^":
                return pow(a, b)
            return error("모르는 연산 " + op)

fn calc(src: Str) -> !Float:
    let toks = try tokenize(src)
    let p = try parse_sum(toks, 0)
    if p.pos != toks.len():
        return error("다 읽지 못한 부분이 있습니다")
    return try eval(p.node)

fn show(src: Str):
    let v = calc(src) catch e:
        print(src + "  ->  오류: " + str(e) + "\n")
        return
    print(src + "  ->  " + str(v) + "\n")

fn main():
    show("1 + 2 * 3")
    show("(1 + 2) * 3")
    show("2 ^ 3 ^ 2")
    show("-4 + 10")
    show("10 / 4")
    show("1 / 0")
    show("2 +")
    show("(1 + 2")
    show("3 $ 4")
