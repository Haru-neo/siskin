# To-do list — reads a JSON file, organizes it, and saves it again
from std.fs import read_text, write_text
from std.json import parse, stringify, jdict, jlist, jstr, jint, jbool

struct Task:
    id: Int
    title: Str
    done: Bool
    pri: Int
    tags: [Str]

# JSON values cannot be given a name (the Json type cannot be used),
# so the reading could not be split into functions and was all crammed into one function.
fn load(path: Str) -> ![Task]:
    let text = try read_text(path)
    let doc = try parse(text)
    var out: [Task] = []
    let arr = doc.get("tasks")
    if arr != none:
        var i = 0
        while i < arr.len():
            let item = arr.at(i)
            if item != none:
                let id = item.get("id")
                if id != none:
                    let idv = id.as_int()
                    if idv != none:
                        let title = item.get("title")
                        if title != none:
                            let tv = title.as_str()
                            if tv != none:
                                let done = item.get("done")
                                if done != none:
                                    let dv = done.as_bool()
                                    if dv != none:
                                        let pri = item.get("pri")
                                        if pri != none:
                                            let pv = pri.as_int()
                                            if pv != none:
                                                var tags: [Str] = []
                                                let tg = item.get("tags")
                                                if tg != none:
                                                    var j = 0
                                                    while j < tg.len():
                                                        let one = tg.at(j)
                                                        if one != none:
                                                            let s = one.as_str()
                                                            if s != none:
                                                                tags.push(s)
                                                        j += 1
                                                out.push(Task(id: idv, title: tv, done: dv, pri: pv, tags: tags))
            i += 1
    return out

fn save(path: Str, tasks: [Task]) -> !Unit:
    let arr = jlist()
    for t in tasks:
        let o = jdict()
        o.set("id", jint(t.id))
        o.set("title", jstr(t.title))
        o.set("done", jbool(t.done))
        o.set("pri", jint(t.pri))
        let tg = jlist()
        for s in t.tags:
            tg.push(jstr(s))
        o.set("tags", tg)
        arr.push(o)
    let root = jdict()
    root.set("tasks", arr)
    try write_text(path, stringify(root))
    return

fn main() -> !Unit:
    var tasks = try load("tasks.json")
    print("loaded " + str(tasks.len()) + " tasks\n\n")

    print("== Open tasks (most urgent first) ==\n")
    var pri = 1
    while pri <= 3:
        for t in tasks:
            if t.done == false and t.pri == pri:
                print("  [" + str(t.pri) + "] " + t.title + "  #" + t.tags.join(" #") + "\n")
        pri += 1

    var open_count = 0
    var by_tag: {Str: Int} = {}
    for t in tasks:
        if t.done == false:
            open_count += 1
        for g in t.tags:
            let cur = by_tag[g]
            if cur != none:
                by_tag[g] = cur + 1
            else:
                by_tag[g] = 1

    print("\nby tag: ")
    for k in by_tag.keys():
        let n = by_tag[k]
        if n != none:
            print(k + "=" + str(n) + " ")
    print("\n" + str(open_count) + " open / " + str(tasks.len()) + " total\n")

    tasks.push(Task(id: 5, title: "Report shortcomings", done: false, pri: 1, tags: ["siskin"]))
    try save("tasks.out.json", tasks)
    print("saved to tasks.out.json\n")
    return
