{
  "name": "siskin",
  "displayName": "Siskin",
  "description": "Siskin language support: syntax highlighting, error squiggles, formatting, go to definition, run button",
  "version": "0.1.0",
  "publisher": "siskin-lang",
  "license": "MIT",
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages", "Formatters", "Linters"],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "siskin",
        "aliases": ["Siskin", "siskin"],
        "extensions": [".skn"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "siskin", "scopeName": "source.siskin", "path": "./syntaxes/siskin.tmLanguage.json" }
    ],
    "configuration": {
      "title": "Siskin",
      "properties": {
        "siskin.path": {
          "type": "string",
          "default": "siskin",
          "description": "Path to the siskin program. Leave as is if it is on your PATH."
        }
      }
    },
    "configurationDefaults": {
      "[siskin]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false
      }
    },
    "commands": [
      { "command": "siskin.run", "title": "Siskin: Run This File", "icon": "$(play)" },
      { "command": "siskin.build", "title": "Siskin: Build Executable" },
      { "command": "siskin.debug", "title": "Siskin: Run in Debugger" },
      { "command": "siskin.restart", "title": "Siskin: Restart Language Server" }
    ],
    "menus": {
      "editor/title/run": [
        { "command": "siskin.run", "when": "editorLangId == siskin", "group": "navigation" }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  }
}
