# Expression calculator — tokenize / parse / evaluate
from std.math import pow

enum Tok:
    Num(v: Float)
    Op(c: Str)
    LPar
    RPar

enum Node:
    Lit(v: Float)
    Bin(op: Str, l: Node, r: Node)
    Neg(e: Node)

# The parser has to return both "the node it built" and "the next position".
# There are no tuples and no way to update the position in place, so this struct exists.
struct Parsed:
    node: Node
    pos: Int

fn is_digit(c: Str) -> Bool:
    return c >= "0" and c <= "9"

fn tokenize(src: Str) -> ![Tok]:
    var out: [Tok] = []
    var i = 0
    while i < src.len():
        let c = src[i]
        if c == " ":
            i += 1
            continue
        if is_digit(c) or c == ".":
            var text = ""
            while i < src.len() and (is_digit(src[i]) or src[i] == "."):
                text += src[i]
                i += 1
            out.push(Num(v: try float(text)))
            continue
        if c == "(":
            out.push(LPar())
            i += 1
            continue
        if c == ")":
            out.push(RPar())
            i += 1
            continue
        if c == "+" or c == "-" or c == "*" or c == "/" or c == "^":
            out.push(Op(c: c))
            i += 1
            continue
        return error("unknown character " + c)
    return out

fn op_at(toks: [Tok], i: Int) -> Str:
    if i >= toks.len():
        return ""
    match toks[i]:
        case Op(c):
            return c
        case Num(v):
            return ""
        case LPar:
            return "("
        case RPar:
            return ")"

# Unary: numbers, parentheses, leading minus
fn parse_unary(toks: [Tok], i: Int) -> !Parsed:
    if i >= toks.len():
        return error("unexpected end of expression")
    if op_at(toks, i) == "-":
        let inner = try parse_unary(toks, i + 1)
        return Parsed(node: Neg(e: inner.node), pos: inner.pos)
    if op_at(toks, i) == "(":
        let inner = try parse_sum(toks, i + 1)
        if op_at(toks, inner.pos) != ")":
            return error("missing closing parenthesis")
        return Parsed(node: inner.node, pos: inner.pos + 1)
    match toks[i]:
        case Num(v):
            return Parsed(node: Lit(v: v), pos: i + 1)
        case Op(c):
            return error("expected a number but got " + c)
        case LPar:
            return error("parenthesis handling error")
        case RPar:
            return error(") without a matching opening parenthesis")

# Exponentiation: right-associative (2^3^2 = 2^9)
fn parse_pow(toks: [Tok], i: Int) -> !Parsed:
    let base = try parse_unary(toks, i)
    if op_at(toks, base.pos) == "^":
        let exp = try parse_pow(toks, base.pos + 1)
        return Parsed(node: Bin(op: "^", l: base.node, r: exp.node), pos: exp.pos)
    return base

# Multiplication and division
fn parse_product(toks: [Tok], i: Int) -> !Parsed:
    var cur = try parse_pow(toks, i)
    while op_at(toks, cur.pos) == "*" or op_at(toks, cur.pos) == "/":
        let sym = op_at(toks, cur.pos)
        let rhs = try parse_pow(toks, cur.pos + 1)
        cur = Parsed(node: Bin(op: sym, l: cur.node, r: rhs.node), pos: rhs.pos)
    return cur

# Addition and subtraction
fn parse_sum(toks: [Tok], i: Int) -> !Parsed:
    var cur = try parse_product(toks, i)
    while op_at(toks, cur.pos) == "+" or op_at(toks, cur.pos) == "-":
        let sym = op_at(toks, cur.pos)
        let rhs = try parse_product(toks, cur.pos + 1)
        cur = Parsed(node: Bin(op: sym, l: cur.node, r: rhs.node), pos: rhs.pos)
    return cur

fn eval(n: Node) -> !Float:
    match n:
        case Lit(v):
            return v
        case Neg(e):
            let inner = try eval(e)
            return -inner
        case Bin(op, l, r):
            let a = try eval(l)
            let b = try eval(r)
            if op == "+":
                return a + b
            if op == "-":
                return a - b
            if op == "*":
                return a * b
            if op == "/":
                if b == 0.0:
                    return error("division by zero")
                return a / b
            if op == "^":
                return pow(a, b)
            return error("unknown operator " + op)

fn calc(src: Str) -> !Float:
    let toks = try tokenize(src)
    let p = try parse_sum(toks, 0)
    if p.pos != toks.len():
        return error("part of the input was not consumed")
    return try eval(p.node)

fn show(src: Str):
    let v = calc(src) catch e:
        print(src + "  ->  error: " + str(e) + "\n")
        return
    print(src + "  ->  " + str(v) + "\n")

fn main():
    show("1 + 2 * 3")
    show("(1 + 2) * 3")
    show("2 ^ 3 ^ 2")
    show("-4 + 10")
    show("10 / 4")
    show("1 / 0")
    show("2 +")
    show("(1 + 2")
    show("3 $ 4")
