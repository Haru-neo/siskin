# Passing functions as values, anonymous functions, closures
#
# `fn(x: Int): x * k` is an unnamed function. It "captures" the outer `k`.
# A captured value is a copy taken when the function is created, and it is read-only inside.

struct Person:
    name: Str
    age: Int

# A function that takes a function. `(Int) -> Int` is the type "function taking an Int and returning an Int".
fn apply_twice(f: (Int) -> Int, x: Int) -> Int:
    return f(f(x))

# A function that returns a function. The returned function remembers n.
fn make_adder(n: Int) -> (Int) -> Int:
    return fn(x): x + n

fn main():
    let k = 3
    let times_k = fn(x: Int): x * k
    print(f"times 3: {times_k(5)}\n")                   # 15

    let add10 = make_adder(10)
    print(f"add 10 twice: {apply_twice(add10, 1)}\n")  # 21

    # Using them with lists — the element type is known, so you don't need to write the type of x.
    let nums = [5, 3, 8, 1, 9, 2]
    let limit = 4
    print(f"squares: {nums.map(fn(x): x * x)}\n")
    print(f"greater than {limit}: {nums.filter(fn(x): x > limit)}\n")
    print(f"contains 9: {nums.any(fn(x): x == 9)}\n")

    var people = [Person(name: "Haru", age: 20), Person(name: "Mika", age: 3), Person(name: "Gaon", age: 7)]
    people.sort_by(fn(p): p.age)
    print(f"by age: {people.map(fn(p): p.name)}\n")

    # If you need several lines, declare a function inside the function. It captures outer values too.
    let unit = " years old"
    fn describe(p: Person) -> Str:
        if p.age < 10:
            return p.name + "(child, " + str(p.age) + unit + ")"
        return p.name + "(" + str(p.age) + unit + ")"
    print(people.map(describe).join(", ") + "\n")

    # A captured value is the value at creation time.
    var base = 1
    let plus_base = fn(x: Int): x + base
    base = 100
    print(f"base was 1 at creation: {plus_base(1)}\n")      # 2
