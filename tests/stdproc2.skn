import std.process
from std.process import cwd, set_cwd
from std.fs import read_text, remove, make_dir, write_text

fn main():
    let t = read_text("/tmp/no_such_file.txt") catch e:
        print("read: " + e + "\n")
        ""
    remove("/tmp/no_such_file.txt") catch e:
        print("remove: " + e + "\n")
    write_text("/tmp/siskin_proc_test/f", "x") catch e:
        print(e + "\n")
    make_dir("/tmp/siskin_proc_test/f") catch e:
        print("folder: " + e + "\n")
    set_cwd("/tmp/siskin_proc_test") catch e:
        print(e + "\n")
    print(cwd() + "\n")
    set_cwd("/no/such/place") catch e:
        print("cd: " + e + "\n")
    let r = process.run("pwd")
    print(r.out)
