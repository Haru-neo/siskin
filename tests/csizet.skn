# size_t parameters from system headers. Newer clang (21+) reports size_t as `__size_t`,
# which generated C wrappers must spell as `size_t` (fread/fwrite failed with LLVM-MinGW clang 22).
import c "stdio.h"
import c "string.h"
from std.fs import remove

fn main():
    print(f"strncmp = {strncmp("siskin", "siskit", 5)}\n")
    unsafe:
        let out = alloc[U8](5)
        for i in range(5):
            out[i] = 104 + i
        let f = fopen("csizet.tmp", "wb")
        print(f"wrote = {fwrite(out, 1, 5, f)}\n")
        fclose(f)
        let back = alloc[U8](8)
        memset(back, 0, 8)
        let g = fopen("csizet.tmp", "rb")
        print(f"read = {fread(back, 1, 8, g)}\n")
        fclose(g)
        print(f"first = {back[0]}, last = {back[4]}, after = {back[5]}\n")
        free(out)
        free(back)
    remove("csizet.tmp")
