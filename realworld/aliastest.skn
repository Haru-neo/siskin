# Value semantics: to modify an argument you must mark it `inout` explicitly.
# A plain argument is read-only, so trying to modify it inside the function is a compile error.
fn bump(inout box: [Int]):
    box[0] += 1

fn add_item(inout xs: [Str]):
    xs.push("added")

fn main():
    var box = [0]
    bump(box)
    print("list slot: " + str(box[0]) + "\n")
    var names = ["Haru"]
    add_item(names)
    print("name count: " + str(names.len()) + "\n")
