# 16. Splitting into files, and namespaces
#
# Names from a file brought in with `import shapes` are written as `shapes.name`.
# So your file and an imported file (or two packages) can use the same name without clashing.
# You can also bring in just the names you use often, like `from shapes import unit_circle`.

import shapes
from shapes import unit_circle as circle1

# shapes also has a describe, but that's fine because we prefix the module name.
fn describe(n: Int) -> Str:
    return f"{n} shapes"

fn main():
    let figs: [shapes.Shape] = [
        circle1(),
        shapes.Box(corner: shapes.Point(x: 1.0, y: 1.0), w: 2.0, h: 3.0),
    ]
    print(describe(figs.len()) + "\n")
    for f in figs:
        print(shapes.describe(f) + "\n")
    match figs[1]:
        case shapes.Box(c, w, h):
            print(f"box corner {c}\n")
        case _:
            pass
