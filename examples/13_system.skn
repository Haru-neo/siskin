# Dates, running other programs, working with folders
import std.time
import std.process
from std.process import env, cwd
from std.fs import make_dir, list_dir, write_text, is_dir

fn main():
    # ---- Dates ----
    let launch = date(2026, 12, 25)
    print(launch.format("%a %b %d, %Y") + "\n")          # Fri Dec 25, 2026
    print(f"a week later: {launch.add_days(7).date_str()}\n")
    print(f"{launch.days_until(date(2027, 1, 1))} days until New Year\n")
    let when = parse_time("2026-03-01 09:30", "%Y-%m-%d %H:%M") catch e:
        print("unexpected date format: " + e + "\n")
        return
    print(when.to_str() + "\n")
    print(f"is this year 2026 or later? {today().year >= 2026}\n")

    # ---- Running other programs ----
    let r = run("echo three one two | tr ' ' '\\n' | sort")   # one shell command line (pipes work)
    print(f"exit code {r.code}, output:\n{r.out}")
    let ls = run_args("ls", ["-d", "/tmp"])     # does not go through the shell
    print(f"ok? {ls.ok()} {ls.out}")
    let home = env("HOME") else "(none)"
    print(f"is HOME set? {home != '(none)'}\n")

    # ---- Folders ----
    let dir = "/tmp/siskin_example_13/a/b"
    make_dir(dir) catch e:                        # creates intermediate folders in one go
        print(e + "\n")
        return
    write_text(dir + "/memo.txt", "hello") catch e:
        print(e + "\n")
    let names = list_dir(dir) catch e:
        print(e + "\n")
        return
    print(f"{names} {is_dir(dir)}\n")
    let missing = list_dir("/tmp/no_such_folder_xyz") catch e:
        print("failed: " + e + "\n")
        []
    print(f"{missing.len()} entries\n")
