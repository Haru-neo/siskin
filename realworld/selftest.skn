struct Counter:
    n: Int
    fn bump(inout self):
        self.n += 1
    fn add(inout self, k: Int):
        self.n += k

fn main():
    var c = Counter(n: 0)
    c.bump()
    c.bump()
    c.add(10)
    print("after bumping three times via methods: " + str(c.n) + "\n")
    c.n += 1
    print("after bumping directly: " + str(c.n) + "\n")
