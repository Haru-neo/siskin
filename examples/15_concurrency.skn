# 15. Doing several things at once — spawn and channel
#
# `spawn function(args)` runs that call in a new task (thread) and returns immediately.
# You get the result later with `.wait()`. Tasks exchange values through channels.
# Values passed to a task are copies, so two tasks never touch the same memory at the same time.
#
# Both `siskin run` and `siskin build` really use multiple CPUs at once.

fn count_primes(lo: Int, hi: Int) -> Int:
    var n = 0
    for x in range(lo, hi):
        if x < 2:
            continue
        var d = 2
        var prime = true
        while d * d <= x:
            if x % d == 0:
                prime = false
                break
            d += 1
        if prime:
            n += 1
    return n

# Counts the words in each received line and sends the count to the result channel.
fn word_counter(lines: Chan[Str], out: Chan[Int]):
    for line in lines:
        out.send(line.split(" ").len())
    out.close()

fn main():
    # 1) Split the work in four and count in parallel.
    var tasks: [Task[Int]] = []
    for i in range(4):
        tasks.push(spawn count_primes(i * 25000, (i + 1) * 25000))
    var total = 0
    for t in tasks:
        total += t.wait()
    print(f"primes below 100,000: {total}\n")

    # 2) Exchanging values through a channel: the sender closes it when done.
    let lines = channel[Str]()
    let counts = channel[Int]()
    let w = spawn word_counter(lines, counts)
    lines.send("one two three")
    lines.send("hello siskin")
    lines.close()
    for c in counts:
        print(f"{c} words\n")
    w.wait()

    # 3) A bounded channel: when full, the sender waits (so the producer doesn't run too far ahead).
    let small = channel[Int](2)
    let p = spawn fill(small, 5)
    var got: [Int] = []
    while true:
        let v = small.recv()
        if v == none:
            break
        got.push(v)
    p.wait()
    print(f"received: {got}\n")

fn fill(ch: Chan[Int], n: Int):
    for i in range(n):
        ch.send(i * 10)
    ch.close()
